# AICTE IICM-SD Production Environment Configuration
# Copy this file to .env before running docker compose
APP_ENV=production
PORT=8000

# Database Configuration (PostgreSQL in Docker; defaults to local SQLite if unset)
POSTGRES_USER=aicte_admin
POSTGRES_PASSWORD=CHANGE_ME_STRONG_DB_PASSWORD_2026
POSTGRES_DB=aicte_iicm_db
DATABASE_URL=postgresql://aicte_admin:CHANGE_ME_STRONG_DB_PASSWORD_2026@postgres:5432/aicte_iicm_db

# JWT & Security Configuration
JWT_SECRET=CHANGE_ME_AICTE_MIC_HMAC_SHA256_SECRET_KEY_2026
JWT_EXPIRY_HOURS=24
ALLOWED_ORIGINS=http://localhost:8080,http://127.0.0.1:8080,http://localhost:3000,http://localhost:5173

# Overlap & SLA Thresholds
OVERLAP_FUZZY_THRESHOLD=78.0
CONTENT_OVERLAP_THRESHOLD=55.0
SLA_DEFAULT_DAYS=30
SLA_WARNING_DAYS=5
PENDING_REMINDER_DAYS=7

# Google Gemini AI Chatbot Configuration
GEMINI_API_KEY=YOUR_GEMINI_API_KEY_HERE
GEMINI_MODEL=gemini-3.1-flash-lite
GEMINI_CHAT_ENABLED=true
GEMINI_REQUEST_TIMEOUT=30
GEMINI_MAX_INPUT_CHARS=2000
GEMINI_MAX_HISTORY_MESSAGES=10
GEMINI_MAX_OUTPUT_TOKENS=1024
GEMINI_RATE_LIMIT_PER_MINUTE=30
